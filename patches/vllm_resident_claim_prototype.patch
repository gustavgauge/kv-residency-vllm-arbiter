index 0000000..6491179
--- /dev/null
+++ b/vllm/v1/core/kv_residency_telemetry.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Env-gated JSONL telemetry for active/resident KV residency probes."""
+
+import json
+import os
+import time
+from typing import Any
+
+from vllm.v1.core.kv_cache_utils import BlockHashWithGroupId
+
+_TELEMETRY_PATH_ENV = "VLLM_KV_RESIDENCY_TELEMETRY_PATH"
+_NO_ADMIT_REQUEST_IDS_ENV = "VLLM_KV_RESIDENCY_NO_ADMIT_REQUEST_IDS"
+_RESIDENT_CLAIM_REQUEST_IDS_ENV = "VLLM_KV_RESIDENCY_CLAIM_REQUEST_IDS"
+_ENFORCE_PROTECTION_ENV = "VLLM_KV_RESIDENCY_ENFORCE_PROTECTION"
+
+
+def _block_hash_to_str(block_hash: BlockHashWithGroupId | None) -> str | None:
+    if block_hash is None:
+        return None
+    return repr(block_hash)
+
+
+def kv_residency_telemetry_enabled() -> bool:
+    return bool(os.environ.get(_TELEMETRY_PATH_ENV))
+
+
+def hard_exclude_protected_residents_enabled() -> bool:
+    return os.environ.get(_ENFORCE_PROTECTION_ENV) == "hard_exclude"
+
+
+def _request_id_matches(request_id: str, expected_id: str) -> bool:
+    return request_id == expected_id or request_id.startswith(f"{expected_id}-")
+
+
+def deny_future_reuse_for_request(request_id: str) -> bool:
+    request_ids = {
+        item.strip()
+        for item in os.environ.get(_NO_ADMIT_REQUEST_IDS_ENV, "").split(",")
+        if item.strip()
+    }
+    return any(_request_id_matches(request_id, item) for item in request_ids)
+
+
+def resident_claim_fields_for_request(request_id: str) -> dict[str, Any]:
+    request_ids = {
+        item.strip()
+        for item in os.environ.get(_RESIDENT_CLAIM_REQUEST_IDS_ENV, "").split(",")
+        if item.strip()
+    }
+    if not any(_request_id_matches(request_id, item) for item in request_ids):
+        return {
+            "claim_id": None,
+            "prefix_id": request_id,
+            "is_protected_resident": False,
+        }
+
+    return {
+        "claim_id": os.environ.get(
+            "VLLM_KV_RESIDENCY_CLAIM_ID", f"claim:{request_id}"
+        ),
+        "prefix_id": os.environ.get("VLLM_KV_RESIDENCY_PREFIX_ID", request_id),
+        "is_protected_resident": True,
+        "useful_threshold_blocks": int(
+            os.environ.get("VLLM_KV_RESIDENCY_USEFUL_THRESHOLD_BLOCKS", "0")
+        ),
+        "predicted_value": float(
+            os.environ.get("VLLM_KV_RESIDENCY_PREDICTED_VALUE", "1.0")
+        ),
+        "confidence": float(os.environ.get("VLLM_KV_RESIDENCY_CONFIDENCE", "1.0")),
+        "protection_mode": os.environ.get(
+            "VLLM_KV_RESIDENCY_PROTECTION_MODE", "hard_exclude"
+        ),
+    }
+
+
+def emit_kv_residency_event(
+    event: str,
+    request_id: str,
+    **fields: Any,
+) -> None:
+    """Append one JSONL event when residency telemetry is enabled.
+
+    This hook is deliberately observational: it should never affect allocator
+    control flow, and failures to emit telemetry are surfaced only when the
+    feature is explicitly enabled by setting the output path.
+    """
+
+    telemetry_path = os.environ.get(_TELEMETRY_PATH_ENV)
+    if not telemetry_path:
+        return
+
+    record = {
+        "schema_version": 1,
+        "timestamp_ns": time.time_ns(),
+        "run_id": os.environ.get("VLLM_KV_RESIDENCY_RUN_ID", "unset"),
+        "event": event,
+        "request_id": request_id,
+        "claim_id": fields.pop("claim_id", None),
+        "prefix_id": fields.pop("prefix_id", None),
+        "policy": os.environ.get("VLLM_KV_RESIDENCY_POLICY", "native"),
+        "usable_blocks": int(os.environ.get("VLLM_KV_RESIDENCY_USABLE_BLOCKS", "0")),
+    }
+    record.update(fields)
+
+    with open(telemetry_path, "a", encoding="utf-8") as f:
+        f.write(json.dumps(record, sort_keys=True, separators=(",", ":")))
+        f.write("\n")
+
+
+__all__ = [
+    "_block_hash_to_str",
+    "deny_future_reuse_for_request",
+    "emit_kv_residency_event",
+    "hard_exclude_protected_residents_enabled",
+    "kv_residency_telemetry_enabled",
+    "resident_claim_fields_for_request",
+]
